# Copy to .env and adjust before running.

DB_DRIVER=sqlite
SQLITE_PATH=./data/flighttracker.db

# Long random string - used to sign session cookies
SESSION_SECRET=change-this-to-something-long-and-random

PORT=3000
BCRYPT_SALT_ROUNDS=12

# Set before going public - without it, anyone can register
INVITE_CODE=

# true if behind a reverse proxy (Caddy/Traefik/nginx) terminating HTTPS -
# needed for rate limiting and secure cookies to work
TRUST_PROXY=false

# Optional - enables the flight-number lookup button on the flight form.
# Free key: https://rapidapi.com/aedbx-aedbx/api/aerodatabox
AERODATABOX_API_KEY=
