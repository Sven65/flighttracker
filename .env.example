# Copy this file to .env and adjust values before running

# Which database driver to use. Only "sqlite" is implemented right now,
# but the driver layer (see db/driver.js) is written so a new value here
# (e.g. "postgres") just needs a matching driver file added to db/.
DB_DRIVER=sqlite

# Where the SQLite database file lives (used by the sqlite driver only)
SQLITE_PATH=./data/flighttracker.db

# Secret used to sign session cookies - change this to a long random string
SESSION_SECRET=change-this-to-something-long-and-random

# Port the app listens on
PORT=3000

# bcrypt cost factor (10-12 is a reasonable range)
BCRYPT_SALT_ROUNDS=12

# Optional: require this exact code to register a new account. Leave
# blank/unset for open registration (fine for a private, home-network-only
# instance). Set this before putting the app on a public URL, or anyone
# who finds it can create an account. Share the code with whoever you
# actually want to have access - it's not tied to any one person, so
# everyone you invite uses the same code.
INVITE_CODE=

# Set to true only if this app sits behind a reverse proxy (Caddy,
# Traefik, nginx, etc.) that terminates HTTPS and forwards the real
# client IP via X-Forwarded-For/X-Forwarded-Proto. This is required for:
#   - login/register rate limiting to see each visitor's real IP instead
#     of the proxy's (without it, everyone shares one rate-limit bucket)
#   - the session cookie's secure flag to work (it's only sent over HTTPS,
#     which the app can only confirm via X-Forwarded-Proto behind a proxy)
# Leave false for local/LAN-only use with no reverse proxy - setting this
# true without a real proxy in front lets a client spoof its own IP and
# defeats rate limiting entirely.
TRUST_PROXY=false

# Optional: enables the "look up from flight number + date" button on the
# flight form, via AeroDataBox (RapidAPI). Leave blank/unset to disable
# the feature entirely - the app works fine without it, manual entry is
# always available regardless. Get a free key at:
# https://rapidapi.com/aedbx-aedbx/api/aerodatabox (subscribe to the free
# "Basic" plan - no credit card needed for it).
AERODATABOX_API_KEY=
