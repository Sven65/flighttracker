# Copy to .env and adjust before running.

# ---- Core ----
DB_DRIVER=sqlite
SQLITE_PATH=./data/flighttracker.db
SESSION_SECRET=change-this-to-something-long-and-random
PORT=3000
BCRYPT_SALT_ROUNDS=12

# ---- Access control ----
# First account ever created becomes admin, no code needed. Every account
# after that needs an invite code generated by an existing user's
# /account page, unless you turn that off below.
REQUIRE_INVITE=true

# true if behind a reverse proxy (Caddy/Traefik/nginx) terminating HTTPS -
# needed for rate limiting and secure cookies to work
TRUST_PROXY=false

# ---- Optional integrations ----
# Enables the flight-number lookup button on the flight form.
# Free key: https://rapidapi.com/aedbx-aedbx/api/aerodatabox
AERODATABOX_API_KEY=
