{
  "name": "flighttracker",
  "version": "1.0.0",
  "description": "Personal flight/aircraft/carrier logbook with login and a swappable DB driver layer",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node --transpile-only src/server.ts",
    "build": "tsc && cp src/db/schema.sql dist/db/schema.sql && cp src/db/indexes.sql dist/db/indexes.sql && cp -r src/db/seeds dist/db/seeds",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "bcryptjs": "^2.4.3",
    "connect-sqlite3": "^0.9.15",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "ts-node": "^10.9.2",
    "@types/node": "^22.7.4",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/connect-sqlite3": "^0.9.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "sqlite3"
    ]
  }
}
