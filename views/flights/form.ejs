<% var title = isEdit ? 'Edit flight' : 'Log a flight' %>
<%- include('../partials/header', { title: title }) %>
<h1><%= title %></h1>
<% if (error) { %><div class="error-banner"><%= error %></div><% } %>

<form class="stacked" action="<%= isEdit ? '/flights/' + flight.id : '/flights' %>" method="POST"
      <% if (lookupEnabled) { %>data-flight-lookup-form<% } %>>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="two-col">
    <div>
      <label for="flightDate">Date</label>
      <input type="date" id="flightDate" name="flightDate" value="<%= flight.flight_date || '' %>" data-role="lookup-date">
    </div>
    <div>
      <label for="flightNumber">Flight number</label>
      <input type="text" id="flightNumber" name="flightNumber" value="<%= flight.flight_number || '' %>" placeholder="e.g. SK1401" data-role="lookup-flight-number">
    </div>
  </div>

  <% if (lookupEnabled) { %>
    <div class="form-actions" style="margin-top:0; margin-bottom:20px;">
      <button type="button" class="btn secondary" data-role="lookup-button">Look up from flight number + date</button>
      <span class="muted" data-role="lookup-status" style="font-size:0.85rem;"></span>
    </div>
  <% } %>

  <div class="two-col">
    <div>
      <label for="origin">Origin</label>
      <div class="search-select" data-search-select data-search-url="/airports/search" data-debounce="250" data-min-chars="2">
        <input type="text" id="origin" name="origin" data-role="search-input" autocomplete="off"
               value="<%= flight.origin || '' %>" placeholder="Search airport name or code">
        <ul class="search-select__results" data-role="results" hidden></ul>
      </div>
    </div>
    <div>
      <label for="destination">Destination</label>
      <div class="search-select" data-search-select data-search-url="/airports/search" data-debounce="250" data-min-chars="2">
        <input type="text" id="destination" name="destination" data-role="search-input" autocomplete="off"
               value="<%= flight.destination || '' %>" placeholder="Search airport name or code">
        <ul class="search-select__results" data-role="results" hidden></ul>
      </div>
    </div>
  </div>

  <div class="two-col">
    <div>
      <label for="departureTime">Departure time (local, optional)</label>
      <input type="time" id="departureTime" name="departureTime" value="<%= flight.departure_time || '' %>">
    </div>
    <div>
      <label for="arrivalTime">Arrival time (local, optional)</label>
      <input type="time" id="arrivalTime" name="arrivalTime" value="<%= flight.arrival_time || '' %>">
    </div>
  </div>

  <label>Flight time (optional)</label>
  <div class="two-col">
    <div>
      <input type="number" id="durationHours" name="durationHours" min="0" max="24" placeholder="Hours"
             value="<%= flight.duration_minutes != null ? Math.floor(flight.duration_minutes / 60) : '' %>">
    </div>
    <div>
      <input type="number" id="durationMinutesInput" name="durationMinutes" min="0" max="59" placeholder="Minutes"
             value="<%= flight.duration_minutes != null ? flight.duration_minutes % 60 : '' %>">
    </div>
  </div>

  <label for="divertedTo">Diverted to (optional)</label>
  <div class="search-select" data-search-select data-search-url="/airports/search" data-debounce="250" data-min-chars="2">
    <input type="text" id="divertedTo" name="divertedTo" data-role="search-input" autocomplete="off"
           value="<%= flight.diverted_to || '' %>" placeholder="Only if this flight actually landed somewhere else">
    <ul class="search-select__results" data-role="results" hidden></ul>
  </div>

  <div class="two-col">
    <div>
      <label for="carrierSearch">Carrier</label>
      <div class="search-select" data-search-select data-search-url="/carriers/search" data-debounce="250" data-min-chars="1">
        <input type="text" id="carrierSearch" data-role="search-input" autocomplete="off"
               value="<%= flight.carrier_name || '' %>" placeholder="Search carriers">
        <input type="hidden" id="carrierId" name="carrierId" data-role="hidden-value" value="<%= flight.carrier_id || '' %>">
        <ul class="search-select__results" data-role="results" hidden></ul>
      </div>
      <p class="muted" style="font-size:0.85rem;">Don't see it? <a href="/carriers/new">Add a carrier</a> first.</p>
    </div>
    <div>
      <label for="aircraftSearch">Aircraft</label>
      <div class="search-select" data-search-select data-search-url="/aircraft/search" data-debounce="250" data-min-chars="1">
        <input type="text" id="aircraftSearch" data-role="search-input" autocomplete="off"
               value="<%= [flight.aircraft_manufacturer, flight.aircraft_model].filter(Boolean).join(' ') %>" placeholder="Search aircraft">
        <input type="hidden" id="aircraftId" name="aircraftId" data-role="hidden-value" value="<%= flight.aircraft_id || '' %>">
        <ul class="search-select__results" data-role="results" hidden></ul>
      </div>
      <p class="muted" style="font-size:0.85rem;">Don't see it? <a href="/aircraft/new">Add an aircraft</a> first.</p>
    </div>
  </div>

  <label for="seat">Seat</label>
  <input type="text" id="seat" name="seat" value="<%= flight.seat || '' %>" placeholder="e.g. 14A">

  <label for="notes">Notes</label>
  <textarea id="notes" name="notes"><%= flight.notes || '' %></textarea>

  <div class="form-actions">
    <button class="btn" type="submit"><%= isEdit ? 'Save changes' : 'Log flight' %></button>
    <a class="btn secondary" href="/flights">Cancel</a>
  </div>
</form>
<%- include('../partials/footer') %>
