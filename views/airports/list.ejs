<% var title = 'Airports' %>
<%- include('../partials/header', { title: title }) %>
<div class="page-header">
  <h1>Airports</h1>
  <a class="btn" href="/airports/new">Add custom airport</a>
</div>
<p class="muted" style="margin-top:-10px; margin-bottom:20px;">
  This only lists airports you've added yourself. The default dataset has thousands of airports worldwide —
  search for them right in the flight form instead of browsing them here.
</p>

<% if (airports.length === 0) { %>
  <p class="empty-state">You haven't added any custom airports — <a href="/airports/new">add one</a> if the default list is missing somewhere you've flown from.</p>
<% } else { %>
  <table>
    <thead>
      <tr><th>ICAO</th><th>IATA</th><th>Name</th><th>Municipality</th><th>Country</th><th></th></tr>
    </thead>
    <tbody>
      <% airports.forEach(function(a) { %>
        <tr>
          <td><%= a.icao_code %></td>
          <td><%= a.iata_code || '—' %></td>
          <td><%= a.name %></td>
          <td><%= a.municipality || '—' %></td>
          <td><%= a.country_code || '—' %></td>
          <td class="actions">
            <form action="/airports/<%= a.icao_code %>/delete" method="POST" onsubmit="return confirm('Delete this airport?');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn danger" type="submit">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>
<%- include('../partials/footer') %>
