<!DOCTYPE html>
<html lang="en"<% if (currentUser && currentUser.theme_preference && currentUser.theme_preference !== 'system') { %> data-theme="<%= currentUser.theme_preference %>"<% } %>>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- Opts out of Dark Reader et al. - the app has its own light/dark mode already. -->
  <meta name="darkreader-lock">

  <% var pageTitle = typeof title !== 'undefined' ? title + ' · Flighttracker' : 'Flighttracker' %>
  <% var pageDescription = 'A personal flight logbook - track flights, carriers, aircraft, and stats.' %>
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= pageDescription %>">

  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Flighttracker">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= pageDescription %>">
  <meta property="og:url" content="<%= siteUrl %><%= originalUrl %>">
  <meta property="og:image" content="<%= siteUrl %>/images/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= pageTitle %>">
  <meta name="twitter:description" content="<%= pageDescription %>">
  <meta name="twitter:image" content="<%= siteUrl %>/images/og-image.png">

  <link rel="stylesheet" href="/css/style.css">
  <% if (typeof extraHead !== 'undefined') { %><%- extraHead %><% } %>
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/">
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12L22 3L14 21L11 13L2 12Z" fill="currentColor"/></svg>
      Flighttracker
    </a>
    <% if (currentUser) { %>
      <nav class="topnav">
        <a href="/">Dashboard</a>
        <a href="/flights">Flights</a>
        <a href="/carriers">Carriers</a>
        <a href="/aircraft">Aircraft</a>
        <a href="/airports">Airports</a>
        <% if (currentUser.is_admin === 1) { %><a href="/admin">Admin</a><% } %>
      </nav>
      <form action="/logout" method="POST" class="logout-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <a href="/account" class="who">@<%= currentUser.username %></a>
        <button type="submit" class="btn secondary small">Log out</button>
      </form>
    <% } %>
  </header>
  <main class="container">
