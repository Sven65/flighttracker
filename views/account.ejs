<% var title = 'Account' %>
<%- include('partials/header', { title: title }) %>
<h1>Account</h1>

<div class="card">
  <h2>Profile</h2>
  <p><strong>Username:</strong> <%= user.username %></p>
  <p class="muted" style="font-size:0.85rem;">Usernames can't be changed.</p>
</div>

<div class="card">
  <h2>Theme</h2>
  <form class="stacked" action="/account/theme" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label for="theme">Appearance</label>
    <select id="theme" name="theme" onchange="this.form.submit()">
      <option value="system" <%= user.theme_preference === 'system' ? 'selected' : '' %>>Match device</option>
      <option value="light" <%= user.theme_preference === 'light' ? 'selected' : '' %>>Light</option>
      <option value="dark" <%= user.theme_preference === 'dark' ? 'selected' : '' %>>Dark</option>
    </select>
  </form>
</div>

<div class="card">
  <h2>Invites</h2>
  <p>
    <% if (user.is_admin === 1) { %>
      You have unlimited invites (admin).
    <% } else { %>
      You have <strong><%= user.invites_remaining %></strong> invite<%= user.invites_remaining === 1 ? '' : 's' %> left.
    <% } %>
  </p>

  <% if (inviteError) { %><div class="error-banner"><%= inviteError %></div><% } %>
  <% if (newInviteCode) { %>
    <p class="highlight-line" style="color: var(--success);">New code: <strong><%= newInviteCode %></strong> — share it with whoever you're inviting. It only works once.</p>
  <% } %>

  <form action="/account/invites" method="POST" style="margin-bottom:20px;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="btn" type="submit" <% if (user.is_admin !== 1 && user.invites_remaining <= 0) { %>disabled<% } %>>Generate invite code</button>
  </form>

  <% if (invites.length === 0) { %>
    <p class="empty-state">You haven't invited anyone yet.</p>
  <% } else { %>
    <table>
      <thead><tr><th>Code</th><th>Status</th><th>Created</th></tr></thead>
      <tbody>
        <% invites.forEach(function(inv) { %>
          <tr>
            <td><%= inv.code %></td>
            <td>
              <% if (inv.used_by) { %>
                <span class="badge badge-custom">Used by <%= inv.used_by_username %></span>
              <% } else { %>
                <span class="badge">Unused</span>
              <% } %>
            </td>
            <td><%= inv.created_at %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<div class="card">
  <h2>Email</h2>
  <% if (emailError) { %><div class="error-banner"><%= emailError %></div><% } %>
  <form class="stacked" action="/account/email" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label for="email">Email (optional)</label>
    <input type="email" id="email" name="email" value="<%= user.email || '' %>">
    <div class="form-actions">
      <button class="btn" type="submit">Save email</button>
    </div>
  </form>
</div>

<div class="card">
  <h2>Change password</h2>
  <% if (passwordError) { %><div class="error-banner"><%= passwordError %></div><% } %>
  <% if (passwordSuccess) { %><p class="highlight-line" style="color: var(--success);">Password updated.</p><% } %>
  <form class="stacked" action="/account/password" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label for="currentPassword">Current password</label>
    <input type="password" id="currentPassword" name="currentPassword" required>

    <label for="newPassword">New password</label>
    <input type="password" id="newPassword" name="newPassword" required minlength="8">

    <label for="newPasswordConfirm">Confirm new password</label>
    <input type="password" id="newPasswordConfirm" name="newPasswordConfirm" required minlength="8">

    <div class="form-actions">
      <button class="btn" type="submit">Change password</button>
    </div>
  </form>
</div>
<%- include('partials/footer') %>
